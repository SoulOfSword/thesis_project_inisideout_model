    "frame.tick_params(labelsize=14)\n",
    "frame.grid(zorder=1)\n",
    "frame.set_ylim(0.5)\n",
    "log_M_bar_array = log_M_bar_array_backup_i  # restore global\n",
    "plt.show()\n"
   ]
