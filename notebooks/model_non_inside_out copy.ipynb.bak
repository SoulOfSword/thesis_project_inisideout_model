    "\n",
    "frame.set_title(\n",
    "    rf\"$\\log(j_{{\\rm bar}})$ vs $\\log(M_{{\\rm bar}})$ vs $f_{{\\rm gas}}$ — Exp (i), BARY full sample\"\n",
    "    + \"\\n\" + f\"(a = {a_median:.2f}, b = {b_median:.2f}, global linear-$\\omega$ model)\", fontsize=15)\n",
    "frame.set_xlabel(r\"$\\log(M_{\\rm bar} \\, / \\, \\rm M_{\\odot})$\", fontsize=15)\n",
